# ==============================================================================
# PROYECTO: MVP WEB SEGALU
# ARCHIVO: .env.example (Plantilla de Variables de Entorno)
# ==============================================================================
# DIDÁCTICA (Pilar de Confidencialidad):
# NUNCA escribas tus claves secretas directamente dentro del código Python (.py).
#
# INSTRUCCIONES:
# 1. Haz una copia de este archivo y llámala exactamente: .env
# 2. En tu panel de Supabase ve a: Project Settings (⚙️) -> API
# 3. Copia tu "Project URL" y tu llave ("anon public" o "service_role") abajo:
# ==============================================================================

SUPABASE_URL="https://tu-proyecto-id.supabase.co"
SUPABASE_KEY="tu-llave-de-supabase-aqui"

# Nombre del Bucket Público en Supabase Storage para guardar las fotos con marca de agua
SUPABASE_BUCKET="multimedia_segalu"

# Contraseña Maestra del Administrador Único (para ingresar a /admin)
ADMIN_PASSWORD="SegaluAdmin2026"

# [FASE 4.5] API Key Gratuita y Modelo Ligero de Google Gemini (gemini-3.5-flash-lite)
# Consíguela gratis en: https://aistudio.google.com/app/apikey
# Si la dejas vacía, el sistema usará automáticamente el Extractor Inteligente Local.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.5-flash-lite

# Puerto local donde correrá nuestro servidor Python (por defecto 8000)
PORT=8000
